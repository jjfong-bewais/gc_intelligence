# Copia a .env (no se sube a git). Para la demo local no hace falta nada.
GC_MODE=prod                       # demo muestra aviso de datos sintéticos
SECRET_KEY=cambia-esto-por-un-valor-largo-y-aleatorio   # python -c "import secrets;print(secrets.token_urlsafe(48))"

# Base de datos: SQLite (demo) o Postgres/Neon (nube)
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/gc?sslmode=require
DATABASE_URL=sqlite:///demo/demo.db
PGVECTOR_TYPE=vector

# Embeddings: local (demo, sin red) | openai
EMBEDDINGS_PROVIDER=local
EMBEDDING_DIM=512
OPENAI_API_KEY=
MATCH_THRESHOLD=0.5                # con openai suele ir mejor ~0.45; calibrar con datos reales

# Correo: console | file | resend
MAIL_PROVIDER=console
RESEND_API_KEY=
MAIL_FROM=GC Intelligence <alertas@tudominio.com>

# URLs públicas (enlaces de los correos) y cookies (en la nube: HTTPS y subdominios del mismo sitio)
APP_URL=http://localhost:8000
API_URL=
CORS_ORIGINS=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOW_SIGNUP=false

DATA_YEAR=2026
